# A landing fala direto com a Bixs (Pix e WhatsApp), sem API própria.
# Os valores ficam visíveis no bundle publicado (risco aceito). NUNCA commite o .env: o repositório é público.
# Na Vercel: Settings → Environment Variables, depois redeploy (o Vite embute os valores no build).
VITE_BIXS_EMAIL=
VITE_BIXS_PASSWORD=
# Usada só nas rotas de pagamento (faturas Pix)
VITE_BIXS_API_KEY=
# Assinatura por plano (opcional). Com o UUID do plano preenchido, o checkout de CPF cria a conta
# do cliente na Bixs e assina o plano (cobrança mensal feita pela Bixs). Vazio = Pix avulso de hoje.
# CNPJ continua no Pix avulso: a Bixs ainda não tem autoassinatura para empresa.
VITE_NOMELIMPO_PLAN_ID=
# Código da aplicação do plano no login do cliente (padrão plus-web, o único que o cadastro aceita hoje)
# VITE_NOMELIMPO_APP_SOURCE=nome-limpo
# Opcional (padrão https://api.bixs.com.br)
# VITE_BIXS_API_BASE=https://api.bixs.com.br
