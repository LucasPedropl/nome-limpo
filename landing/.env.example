# URL base da API NomeLimpo (sem barra no final). Obrigatória em produção:
# sem ela o build aponta para http://localhost:5240 e o checkout exibe erro ao gerar o Pix.
# Dev: http://localhost:5240 | Produção: URL pública da API no Render (ex.: https://<servico>.onrender.com)
VITE_API_BASE_URL=http://localhost:5240

# "false" oculta a etapa do código no e-mail e vai direto do cadastro para o PIX (demonstração sem SMTP).
# Precisa casar com Checkout__ExigirVerificacaoEmail=false na API. Padrão: etapa ligada.
VITE_CHECKOUT_EXIGIR_EMAIL=true

# URL do sistema (frontend) para onde o cliente vai depois do pagamento confirmado. Vazio = fica na tela de sucesso.
# Ex.: https://frontend-ashen-seven-81.vercel.app/?demo=1  (?demo=1 abre o sistema no modo mockado, sem login)
VITE_SISTEMA_URL=
