# A landing fala direto com a Bixs (Pix e WhatsApp), sem API própria.
# Os valores ficam visíveis no bundle publicado (risco aceito). NUNCA commite o .env: o repositório é público.
# Na Vercel: Settings → Environment Variables, depois redeploy (o Vite embute os valores no build).
VITE_BIXS_EMAIL=
VITE_BIXS_PASSWORD=
# Usada só nas rotas de pagamento (faturas Pix)
VITE_BIXS_API_KEY=
# Opcional (padrão https://api.bixs.com.br)
# VITE_BIXS_API_BASE=https://api.bixs.com.br
